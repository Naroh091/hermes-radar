{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "mode", "owner", "destination", "observation", "scheduler", "notifications", "limits", "retention", "sources", "allowed_operations", "mutations"],
  "properties": {
    "enabled": {"type": "boolean", "default": false},
    "mode": {"enum": ["shadow", "active"], "default": "shadow"},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "timezone", "language"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "timezone": {"type": "string", "default": "UTC"},
        "language": {"type": "string", "default": "es"}
      }
    },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "gateway_connection_ref", "resolution", "address", "owner_platform_id", "allow_groups", "verified"],
      "properties": {
        "platform": {"type": ["string", "null"]},
        "gateway_connection_ref": {"type": ["string", "null"]},
        "resolution": {"const": "explicit"},
        "address": {"type": "object"},
        "owner_platform_id": {"type": ["string", "null"]},
        "allow_groups": {"type": "boolean", "default": false},
        "verified": {"const": false, "description": "Server-managed verification state; configuration cannot assert it."}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["local_sessions", "historical_import"],
      "properties": {"local_sessions": {"type": "boolean", "default": false}, "historical_import": {"type": "boolean", "default": false}}
    },
    "scheduler": {
      "type": "object", "additionalProperties": false,
      "required": ["tick_seconds", "max_concurrent_checks"],
      "properties": {"tick_seconds": {"type": "integer", "minimum": 1, "default": 60}, "max_concurrent_checks": {"type": "integer", "minimum": 1, "default": 2}}
    },
    "notifications": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "quiet_start", "quiet_end", "daily_limit", "batch_minutes", "reminder_cooldown_hours"],
      "properties": {
        "enabled": {"type": "boolean", "default": false}, "quiet_start": {"type": "string", "default": "22:00"},
        "quiet_end": {"type": "string", "default": "08:00"}, "daily_limit": {"type": "integer", "minimum": 1, "default": 3},
        "batch_minutes": {"type": "integer", "minimum": 1, "default": 30}, "reminder_cooldown_hours": {"type": "integer", "minimum": 1, "default": 24}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["events_per_source_cycle", "checks_per_day", "llm_calls_per_day", "llm_input_tokens", "llm_output_tokens"],
      "properties": {
        "events_per_source_cycle": {"type": "integer", "minimum": 1, "default": 100}, "checks_per_day": {"type": "integer", "minimum": 1, "default": 200},
        "llm_calls_per_day": {"type": "integer", "minimum": 1, "default": 20}, "llm_input_tokens": {"type": "integer", "minimum": 1, "default": 2000},
        "llm_output_tokens": {"type": "integer", "minimum": 1, "default": 500}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["observations_days", "results_days", "audit_days"],
      "properties": {"observations_days": {"type": "integer", "minimum": 1, "default": 30}, "results_days": {"type": "integer", "minimum": 1, "default": 30}, "audit_days": {"type": "integer", "minimum": 1, "default": 90}}
    },
    "sources": {
      "type": "array", "default": [],
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"const": "http_status"},
          "url": {"type": "string", "pattern": "^https://"},
          "interval_seconds": {"type": "integer", "minimum": 1, "default": 300},
          "retention_days": {"type": "integer", "minimum": 1},
          "enabled": {"type": "boolean", "default": true},
          "operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": ["http_status.check"]}
        }
      }
    },
    "allowed_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []},
    "mutations": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "require_per_action_consent"],
      "properties": {"enabled": {"type": "boolean", "default": false}, "require_per_action_consent": {"const": true}}
    }
  }
}
